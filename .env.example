# Optional environment overrides (config.json is preferred).
# Path to config file (default: ./config.json)
# WG_CONFIG=config.json

# Force-disable API regardless of config.json
# WG_API=0

# Any of these override matching fields in config.json when set:
# API_PORT=8080
# API_KEY=override-secret
# WG_LISTEN_PORT=51820
# WG_SUBNET=10.8.0.0/24
# WG_SERVER_IP=10.8.0.1
# WG_SERVER_ENDPOINT=vpn.example.com:51820
# WG_DNS=1.1.1.1
# WG_OUT_INTERFACE=ens3
# WG_KEEPALIVE_INTERVAL=25
# WG_SESSION_IDLE_SECONDS=180
# DB_PATH=wireguard-wg0.db
# LOG_LEVEL=verbose
